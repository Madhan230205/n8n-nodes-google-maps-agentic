{
  "name": "n8n-nodes-google-maps-agentic",
  "version": "0.5.5",
  "description": "Production-grade Google Maps & Places API scraper for n8n. Specifically designed for AI Agents, B2B lead generation, and mass email scraping without rate limits.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "n8n-node",
    "google-maps",
    "google-places",
    "scraper",
    "lead-generation",
    "b2b",
    "email-extractor",
    "ai-agent",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/n8n-nodes-google-maps-agentic",
  "author": "Madv6",
  "repository": {
    "type": "git",
    "url": "https://github.com/Madhan230205/n8n-nodes-google-maps-agentic.git"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix"
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/request-promise-native": "~1.0.15",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.29.0",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "n8n-core": "*",
    "n8n-workflow": "*",
    "prettier": "^2.7.1",
    "typescript": "^5.9.3"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GoogleMapsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GoogleMaps/GoogleMaps.node.js"
    ]
  }
}
